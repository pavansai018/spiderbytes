  <child link="foot_fr"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>
<joint name="foot_joint_rl" type="fixed">
  <parent link="leg_rl"/>
  <child link="foot_rl"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>
<joint name="foot_joint_rr" type="fixed">
  <parent link="leg_rr"/>
  <child link="foot_rr"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint> -->

<joint name="foot_joint_fl" type="continuous">
  <parent link="leg_fl"/>
  <child link="foot_fl"/>
  <axis xyz="1 0 0"/>
  <origin xyz="0.040 0 -0.105" rpy="0 0 0"/>
</joint>
<joint name="foot_joint_fr" type="continuous">
  <parent link="leg_fr"/>
  <child link="foot_fr"/>
  <axis xyz="-1 0 0"/>
  <origin xyz="0.040 0 -0.105" rpy="0 0 0"/>
</joint>
<joint name="foot_joint_rl" type="continuous">
  <parent link="leg_rl"/>
  <child link="foot_rl"/>
  <axis xyz="1 0 0"/>
  <origin xyz="0.040 0 -0.105" rpy="0 0 0"/>
</joint>
<joint name="foot_joint_rr" type="continuous">
  <parent link="leg_rr"/>
  <child link="foot_rr"/>
  <axis xyz="-1 0 0"/>
  <origin xyz="0.040 0 -0.105" rpy="0 0 0"/>
</joint>

  <!-- <gazebo reference="leg_fl"><mu1>5</mu1><mu2>5</mu2></gazebo>
  <gazebo reference="leg_fr"><mu1>5</mu1><mu2>5</mu2></gazebo>
  <gazebo reference="leg_rr"><mu1>5</mu1><mu2>5</mu2></gazebo>
  <gazebo reference="leg_rl"><mu1>5</mu1><mu2>5</mu2></gazebo> -->
  <gazebo reference="foot_fl"><mu1>5</mu1><mu2>5</mu2></gazebo>
  <gazebo reference="foot_fr"><mu1>5</mu1><mu2>5</mu2></gazebo>
  <gazebo reference="foot_rr"><mu1>5</mu1><mu2>5</mu2></gazebo>
  <gazebo reference="foot_rl"><mu1>5</mu1><mu2>5</mu2></gazebo>

    <!-- <gazebo reference="foot_fl">
        <mu1 value="200.0" />
        <mu2 value="200.0" />
        <kp  value="1000000.0" />
        <kd  value="1.0" />
        <minDepth>0.005</minDepth>
    </gazebo>
    <gazebo reference="foot_fr">
        <mu1 value="200.0" />
        <mu2 value="200.0" />
        <kp  value="1000000.0" />
        <kd  value="1.0" />
        <minDepth>0.005</minDepth>
    </gazebo>
    <gazebo reference="foot_rl">
        <mu1 value="200.0" />
        <mu2 value="200.0" />
        <kp  value="1000000.0" />
        <kd  value="1.0" />
        <minDepth>0.005</minDepth>
    </gazebo>
    <gazebo reference="foot_rl">
        <mu1 value="200.0" />
        <mu2 value="200.0" />
        <kp  value="1000000.0" />
        <kd  value="1.0" />
        <minDepth>0.005</minDepth>
    </gazebo> -->
    <gazebo>
        <plugin name="ignition::gazebo::systems::DiffDrive" filename="ignition-gazebo-diff-drive-system"> 
            <num_wheel_pairs>2</num_wheel_pairs>
            <!-- Wheel Information -->
            <left_joint>foot_joint_fl</left_joint>
            <left_joint>foot_joint_rl</left_joint>
            <right_joint>foot_joint_fr</right_joint>
            <right_joint>foot_joint_rr</right_joint>
            <wheel_separation>0.26</wheel_separation>
            <wheel_radius>0.018</wheel_radius>

            <!-- Limits -->
            <max_linear_acceleration>5</max_linear_acceleration>
            <min_linear_acceleration>-5</min_linear_acceleration>
            <max_angular_acceleration>4</max_angular_acceleration>
            <min_angular_acceleration>-4</min_angular_acceleration>

            <max_linear_velocity>5.0</max_linear_velocity>
            <min_linear_velocity>-5.0</min_linear_velocity>
            <max_angular_velocity>4.0</max_angular_velocity>
            <min_angular_velocity>-4.0</min_angular_velocity>
            <!-- Output -->
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>

            <!-- Topics -->
            <topic>/cmd_vel</topic>
            <odom_topic>/odometry/wheels</odom_topic>
            <tf_topic>/tf_gazebo</tf_topic>

        </plugin>

        <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
            <topic>/joint_states</topic>
        </plugin>
    </gazebo>
  <ros2_control name="spiderbytes_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="hip_joint_fl"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="hip_joint_fr"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="hip_joint_rr"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="hip_joint_rl"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>

    <joint name="knee_joint_fl"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="knee_joint_fr"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="knee_joint_rr"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="knee_joint_rl"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>

    <joint name="leg_joint_rr"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="leg_joint_rl"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="leg_joint_fr"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="leg_joint_fl"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg ros2_control_yaml)</parameters>
    </plugin>
  </gazebo>
</robot>
