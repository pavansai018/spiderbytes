<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spiderbytes_v8">
<xacro:arg name="ros2_control_yaml" default=""/>
<xacro:include filename="$(find spiderbytes)/urdf/accessories/camera.urdf" />
  <!-- ================= BASE ================= -->
  <link name="base_link">
 <visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <geometry>
      <box size="0.095 0.067221 0.095"/>
    </geometry>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <geometry>
      <box size="0.095 0.067221 0.095"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <mass value="5.0"/>
    <inertia
      ixx="0.0221"
      iyy="0.0193"
      izz="0.0221"
      ixy="0"
      ixz="0"
      iyz="0"/>
  </inertial>
</link>

  <!-- HIP -->
  <link name="hip_fl">
    <visual>
    <geometry>
      <cylinder radius="0.018" length="0.066"/>
    </geometry>
  </visual>
  <collision>
    <geometry>
      <cylinder radius="0.018" length="0.066"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.2"/>
    <inertia
      ixx="0.000073"
      iyy="0.000072"
      izz="0.000072"
      ixy="0"
      ixz="0"
      iyz="0"/>
  </inertial>

  </link>

  <joint name="hip_joint_fl" type="revolute">
    <parent link="base_link"/>
    <child link="hip_fl"/>
    <origin xyz="0.055 0.055 0" rpy="0 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="100"/>
  </joint>

  <!-- THIGH -->
  <link name="thigh_fl">
    <visual>
    <origin xyz="0.025 0 0" rpy="0 1.5708 0" />
    <geometry>
      <cylinder radius="0.018" length="0.066"/>
    </geometry>
  </visual>
  <collision>
      <origin xyz="0.025 0 0" rpy="0 1.5708 0"/>
    <geometry>
      <cylinder radius="0.018" length="0.066"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <mass value="0.2"/>
    <inertia
      ixx="0.000073"
      iyy="0.000072"
      izz="0.000072"
      ixy="0"
      ixz="0"
      iyz="0"/>
  </inertial>

  </link>

  <joint name="knee_joint_fl" type="revolute">
    <parent link="hip_fl"/>
    <child link="thigh_fl"/>
    <origin xyz="0.025 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="100"/>
  </joint>

  <!-- LEG -->
  <link name="leg_fl">
    <visual>
    <origin xyz="0.045 0 -0.035"/>
    <geometry>
      <cylinder radius="0.018" length="0.102"/>
    </geometry>
  </visual>
  <collision>
  <origin xyz="0.045 0 -0.035"/>
