      <cylinder radius="0.018" length="0.102"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <mass value="0.25"/>
    <inertia
      ixx="0.000045"
      iyy="0.00214525"
      izz="0.00214525"
      ixy="0"
      ixz="0"
      iyz="0"/>
  </inertial>

  </link>

  <joint name="leg_joint_fl" type="revolute">
